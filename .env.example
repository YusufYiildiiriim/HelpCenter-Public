# Copy this file to .env and replace every placeholder. The root .env is the only local runtime
# configuration file; it is ignored by Git and must never be committed.

# Local .NET development uses this connection string. Set its password to the same value as
# SA_PASSWORD below. Docker Compose replaces it with its internal SQL Server connection.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=HelpCenterDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True
SA_PASSWORD=CHANGE_ME

# Backend authentication
JwtSettings__SecretKey=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# SMTP mail delivery. All values are required because SmtpOptions validates them at startup.
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__Username=CHANGE_ME@example.com
SmtpSettings__Password=CHANGE_ME
SmtpSettings__FromAddress=CHANGE_ME@example.com
SmtpSettings__DisplayName=HelpCenter
SmtpSettings__EnableSsl=true

# Browser and API origins. For production, set all three to the public HTTPS origin.
NEXT_PUBLIC_API_URL=http://localhost:5005
NEXT_PUBLIC_APP_URL=http://localhost:3000
AppSettings__FrontendUrl=http://localhost:3000
NEXT_PUBLIC_DEMO_SSO_ENABLED=false

# Production Caddy only. APP_DOMAIN has no protocol.
APP_DOMAIN=help.example.com
ACME_EMAIL=ops@example.com
