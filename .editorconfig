# Domain-specific suppressions
dotnet_diagnostic.CA1716.severity = none      # 'Module' is VB keyword, not C#
dotnet_diagnostic.CA1711.severity = none      # 'Permission' suffix is domain concept
dotnet_diagnostic.CA1805.severity = none      # Explicit default init in EF entities
dotnet_diagnostic.MA0048.severity = none      # Multiple types per file
dotnet_diagnostic.S101.severity = none        # Domain naming (e.g. FAQ)

# Warnings to fix later (1.6 domain cleanup)
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1311.severity = suggestion
dotnet_diagnostic.MA0011.severity = suggestion
dotnet_diagnostic.MA0002.severity = suggestion
dotnet_diagnostic.MA0006.severity = suggestion
dotnet_diagnostic.MA0009.severity = suggestion
dotnet_diagnostic.MA0110.severity = suggestion
dotnet_diagnostic.SYSLIB1045.severity = suggestion

# ASP.NET Core — no SynchronizationContext
dotnet_diagnostic.MA0004.severity = none

# Logger source-gen deferred
dotnet_diagnostic.CA1873.severity = none

# Method length / complexity deferred to 1.6
dotnet_diagnostic.MA0051.severity = suggestion

# Minor style / performance deferred
dotnet_diagnostic.MA0020.severity = suggestion
dotnet_diagnostic.MA0089.severity = suggestion
