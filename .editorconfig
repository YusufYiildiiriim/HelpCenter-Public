dotnet_diagnostic.IDE0011.severity = none
csharp_prefer_braces = false:none


[*.cs]
# 1. Parametrelerin PascalCase (ServiceCollection) yazılmasına izin ver / uyarmayı kapat
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.ResharperInconsistentNaming.severity = none

# 2. Tek satır 'if' ve parantezsiz kullanım uyarılarını kapat
csharp_prefer_braces = false:none
dotnet_diagnostic.IDE0011.severity = none