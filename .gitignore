## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## See https://learn.microsoft.com/en-us/visualstudio/ide/applying-work-item-types-to-existing-projects

# User-specific files
.editorconfig
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.dotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
# [Ll]og/
# [Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-agent.log

# Build logs
*.log

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.buildlog
*.aps
*.ncb
*.opendb
*.sdf
*.cachefile
*.nosync
*.db
*.db-shm
*.db-wal

# Visual Studio code coverage results
*.coverage
*.coveragexml

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.bak

# Fabric
.fabric/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegencache.json

# Since there are multiple folders, until you check-in one, they won't be seen by Visual Studio.
# Adding a "keep me" file helps with that.
# !**/bin/keepme
# !**/obj/keepme

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Repository Config
# NuGet.Config
# NuGet.exe

# Microsoft Azure Build Output
Antares/

# Service Fabric SDK packages
UpdatedReferenceDlls/

# Azure IoT Edge build outputs
iotedgehubdev/

# Cake - Build Automation System
tools/**
!tools/packages.config

# Tabs Studio
*.tss

# Telerik UI for WinForms
*.vsproj

# OctoPack
*.nuspec

# ReSharper is a 3rd party add-on in Visual Studio
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Ionide
.ionide/

# F# Analyzer
.analyzer/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject is a documentation generator add-on
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Redgate SQL Tools
*_RefactorLog.xml

# ODP.NET Application Configuration
XmlSchemas/
Conf/

# EF Core Migrations Snapshot (optional)
# *.Designer.cs

# Next.js
.next/
out/
build/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker
.dockerignore

# Agents
.agents/

# Claude Code
.claude/

# API logs
help-center-backend/HelpCenter.WebApi/Logs/

# Runtime-uploaded user content
help-center-backend/HelpCenter.WebApi/Uploads/

# JetBrains Rider
.idea/
